{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "apple-price-tracker",
  "main": "./src/worker/index.ts",
  "compatibility_date": "2026-08-27",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "observability": { "enabled": true },

  // Cost guard (ai-sdlc references/cloudflare.md). The heaviest request parses
  // the ~8 MB KV snapshot: about 70 ms cold on a laptop, so 500 ms leaves room
  // for slower edge hardware and still stops a runaway isolate.
  // Worst request: 3 KV reads + 1 exchange-rate fetch + 1 KV write = 5; 10 leaves margin.
  "limits": { "cpu_ms": 500, "subrequests": 10 },

  // Per-client cap on everything that reaches the Worker (/api/*, /mcp, /llms.txt);
  // static assets are served without it. Namespace 7001: eugnel-ltd repos use N001 blocks.
  "ratelimits": [
    { "name": "RATE_LIMIT", "namespace_id": "7001", "simple": { "limit": 120, "period": 60 } }
  ],

  "routes": [{ "pattern": "apple-price-tracker.eugnel.com", "custom_domain": true }],

  "assets": {
    "directory": "./dist/public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/mcp", "/llms.txt"]
  },

  // Deliberately empty, and deliberately present: omitting the field leaves
  // whatever triggers the account already has, so this is what actually clears
  // them. Collection lives in .github/workflows/collect.yml -- a free plan's
  // cron gets 4.8 CPU-seconds a day and a full sweep needs about five.
  "triggers": { "crons": [] },

  "kv_namespaces": [{ "binding": "PRICES", "id": "47e39bc1784b4a7d8942a7d9fb61c235" }],

  "d1_databases": [
    {
      "binding": "HISTORY",
      "database_name": "price-history",
      "database_id": "64d8055c-e578-4360-869f-8703c783bb4a",
      "migrations_dir": "migrations"
    }
  ]
}
