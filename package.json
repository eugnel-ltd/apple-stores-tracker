{
  "name": "apple-price-tracker",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "test": "vitest run",
    "check:governance": "node scripts/sdlc/check-contracts.mjs && node --test scripts/sdlc/route.test.mjs",
    "ci": "npm run check:governance && npm test && npm run build",
    "dev:worker": "wrangler dev",
    "deploy": "npm run build && wrangler deploy",
    "release": "jiti scripts/release.ts",
    "db:migrate": "wrangler d1 migrations apply price-history --remote",
    "db:migrate:local": "wrangler d1 migrations apply price-history --local"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260827.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.4.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.1.0",
    "jiti": "^2.7.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^8.3.5",
    "vitest": "^4.1.12",
    "wrangler": "^4.155.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "workerd@1.20261023.1": true
  }
}
